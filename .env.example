# Square — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to source control.

# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ─── IBM watsonx Orchestrate ──────────────────────────────────────────────────
ORCHESTRATE_INSTANCE_URL=
ORCHESTRATE_API_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/square

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_data
# CHROMA_DB_URL=http://localhost:8001   # uncomment for hosted Chroma

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App Security ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
SESSION_EXPIRE_HOURS=24

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=5
MAX_WORKFLOW_DESCRIPTION_LENGTH=2000

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to True to return seeded mock data (no watsonx calls required)
DEMO_MODE=True
